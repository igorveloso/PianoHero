{
  "expo": {
    "name": "Piano Hero",
    "slug": "piano-hero",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0A0A0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.igorveloso.pianohero",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Piano Hero usa Bluetooth para conectar ao seu teclado Roland.",
        "NSBluetoothPeripheralUsageDescription": "Piano Hero usa Bluetooth para conectar ao seu teclado Roland."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0F"
      },
      "package": "com.igorveloso.pianohero",
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": ["peripheral", "central"],
          "bluetoothAlwaysPermission": "Piano Hero usa Bluetooth para conectar ao seu teclado Roland."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "pianohero"
  }
}
